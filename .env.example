# ─────────────────────────────────────────────────────────────
# WordPress + MySQL stack — full environment sample.
#
#   cp .env.example .env
#
# Then, at minimum:
#   1. set DB_PASSWORD to a long random value (required — compose refuses to start without it)
#   2. set WP_HOME / WP_SITEURL to your real site URL
#   3. set the eight WORDPRESS_*_KEY/SALT values below (each unique, 64+ chars)
#
# `.env` is git-ignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ─── Database credentials ────────────────────────────────────
# Application database. Used by both `db` (created on first boot) and `wordpress`.
#
# IMPORTANT — Compose interpolates `$` inside every value below, so a literal `$`
# will be swallowed or doubled instead of passed through. Quoting does NOT protect
# it. Choose passwords free of `$` (`openssl rand -base64 36` qualifies), and see
# the salts note further down for the `_FILE` escape hatch when you cannot avoid it.
# Everything else is safe verbatim: `#` only starts a comment after whitespace,
# and `&`, `|`, `!`, `[`, `]`, `~`, `%` pass through unchanged.
DB_NAME=wordpress
DB_USER=wordpress
# REQUIRED. Long random value, e.g. `openssl rand -base64 36`.
DB_PASSWORD=

# Table prefix inside the database. Change before the first boot only; changing
# it later orphans every existing table.
DB_TABLE_PREFIX=wp_

# MySQL root password. Leave empty to have the image generate a strong random
# one on first boot (shown once: `docker compose logs db | grep -i "GENERATED ROOT PASSWORD"`).
# Never set this to the same value as DB_PASSWORD.
DB_ROOT_PASSWORD=

# ─── Published port / bind address ───────────────────────────
# Host port for the WordPress container's port 80.
WORDPRESS_PORT=8080
# Interface to publish on. 0.0.0.0 = all interfaces; 127.0.0.1 keeps it
# loopback-only (use this when a host-level reverse proxy terminates TLS).
WORDPRESS_BIND_ADDR=0.0.0.0

# ─── Site URL ────────────────────────────────────────────────
# Becomes the WP_HOME / WP_SITEURL constants. Must match how visitors reach the
# site, including scheme; otherwise the admin area redirects in a loop.
# Local:      http://localhost:8080
# Production: https://blog.example.com
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080

# ─── Debugging ───────────────────────────────────────────────
# 0 = off (production), 1 = WP_DEBUG on. Never leave this on in production.
WORDPRESS_DEBUG=0

# ─── WordPress salts and keys (wp-config.php) ────────────────
# Each value must be unique and at least 64 characters. Generate your own set at
# https://api.wordpress.org/secret-key/1.1/salt/ and replace ALL eight entries
# below — the values shipped here are public sample values, not secrets.
#
# Paste the generated lines directly (they parse fine unquoted as long as the
# value contains no `$`; see the note above). If a value does contain `$`, the
# image's `_FILE` variants are the escape hatch: drop the value from here, add a
# Docker secret, and pass e.g. WORDPRESS_AUTH_KEY_FILE=/run/secrets/auth_key
# under `environment:` in compose.yaml — the image reads those in preference to
# the plain variables.
WORDPRESS_AUTH_KEY=A?[?te&;JL1l>}lLTObZ]}(1<}MPJx-Xi[ccKh^n}={7e5bjiaKR%n>f5.iCQS3j
WORDPRESS_SECURE_AUTH_KEY=QmF&yAirNZAK*4B(OC|mWHxI<}+smKnqFZf7*uKs#!?^9SUMR~w9a:n_&|-<|Gc
WORDPRESS_LOGGED_IN_KEY=sJB~aIc:0)I%&!1T.?n^%x]Ps>+F2GrFr_Wx1Glk2=;[,BZ~B.PpQOR+=+l<]TJH
WORDPRESS_NONCE_KEY=sP*l4vo+TW{@VS+Mqx9%&g737DH%-IpAoA%]fIfcpk.Sa^=P2@x}>BUNCAq{)iwP
WORDPRESS_AUTH_SALT=,)c1Hx07.+eZ[XyqwIi:T7rr(5ObAcy;ih4yRtg5CBxM+]2FP~xLT)%*XuItZ[:A
WORDPRESS_SECURE_AUTH_SALT=Yi:rsvwCoq7C5(w4DXMvlk#tLMVk*nFuB9>nRnCl&PUnm;KOr|1W3~6Wi.i^CFRS
WORDPRESS_LOGGED_IN_SALT=&_6gFC@(qm]wDl&?y#-Rl1fun0iC^h~DV*j%Jkzv<S=0|**7TvQ%uYRQN2{<ql6i
WORDPRESS_NONCE_SALT=OHOUhPS3>uK.^s4wgW{h+2mL3;S2*IxdM^j&LP49|WVtq}5<_vu2lkrDvK^3#Xgy

# ─── Image pins (optional) ───────────────────────────────────
# Defaults are declared in compose.yaml; uncomment to override.
#WORDPRESS_IMAGE=wordpress:7.1-php8.3-apache
#DB_IMAGE=mysql:8.4

# ─── Tuning applied inside wp-config.php (optional) ──────────
# Only edit compose.yaml's WORDPRESS_CONFIG_EXTRA block for these: it is a PHP
# snippet, not plain environment configuration. Current defaults:
#   WP_MEMORY_LIMIT=256M, WP_MAX_MEMORY_LIMIT=512M, WP_POST_REVISIONS=20,
#   DISALLOW_FILE_EDIT=true, AUTOMATIC_UPDATER_DISABLED=false
# PHP upload limits live in uploads.ini (upload_max_filesize / post_max_size).
