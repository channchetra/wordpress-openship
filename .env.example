# ─────────────────────────────────────────────────────────────
# WordPress + MySQL stack — full environment sample.
#
#   cp .env.example .env
#
# Then, at minimum:
#   1. set DB_PASSWORD to a long random value (required — compose refuses to start without it)
#   2. optionally set WP_HOME / WP_SITEURL to your public site URL (see the note below)
#
# There are no salt variables: wp-config.php is generated on first boot with a
# unique random value for every key and salt. Nothing to paste, nothing to leak.
#
# `.env` is git-ignored. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ─── Database credentials ────────────────────────────────────
# Application database. Used by both `db` (created on first boot) and `wordpress`.
#
# IMPORTANT — Compose interpolates `$` inside every value below, so a literal `$`
# will be swallowed or doubled instead of passed through. Quoting does NOT protect
# it. Choose passwords free of `$` (`openssl rand -base64 36` qualifies).
# Everything else is safe verbatim: `#` only starts a comment after whitespace,
# and `&`, `|`, `!`, `[`, `]`, `~`, `%` pass through unchanged.
DB_NAME=wordpress
DB_USER=wordpress
# REQUIRED. Long random value, e.g. `openssl rand -base64 36`.
DB_PASSWORD=

# Table prefix inside the database. Change before the first boot only; changing
# it later orphans every existing table.
DB_TABLE_PREFIX=wp_

# MySQL root password. Leave empty to have the image generate a strong random
# one on first boot (shown once: `docker compose logs db | grep -i "GENERATED ROOT PASSWORD"`).
# Never set this to the same value as DB_PASSWORD.
DB_ROOT_PASSWORD=

# ─── Published port / bind address ───────────────────────────
# Host port for the WordPress container's port 80.
WORDPRESS_PORT=8080
# Interface to publish on. 0.0.0.0 = all interfaces; 127.0.0.1 keeps it
# loopback-only (use this when a host-level reverse proxy terminates TLS).
WORDPRESS_BIND_ADDR=0.0.0.0

# ─── Site URL (optional) ─────────────────────────────────────
# These become the WP_HOME / WP_SITEURL constants, which override the `home` and
# `siteurl` rows in wp_options. WordPress' own URL generation is database-driven,
# so this is a convenience, not a requirement:
#
#   * Leave them set (recommended when the public URL is known): every URL
#     WordPress emits is pinned to that value, so moving the app to another
#     domain or host later is one `.env` change — no database surgery.
#   * Leave them EMPTY: WordPress uses the database values, which the installer
#     seeds from the URL you happen to install from. Fine as long as nothing else
#     reaches the site while it is installing, and you accept that a later domain
#     change means running `wp option update home` and `... siteurl`.
#
# Caution: do not set a placeholder like http://localhost:8080 while exposing the
# site on a real domain — WordPress will then redirect visitors and assets to
# localhost. Set it to the URL visitors actually use, or leave it empty.
#
# Local:      http://localhost:8080
# Production: https://blog.example.com
WP_HOME=
WP_SITEURL=

# ─── Debugging ───────────────────────────────────────────────
# 0 = off (production), 1 = WP_DEBUG on. Never leave this on in production.
WORDPRESS_DEBUG=0

# ─── Keys and salts: handled automatically ───────────────────
# On first boot the entrypoint writes wp-config.php and replaces every
# "put your unique phrase here" placeholder with a unique random value
# (sha1 of 1 MB of /dev/urandom) — so all eight keys/salts are unique per site
# with no configuration. They live in wp-config.php inside the `wp_app` volume.
#
# To pin your own instead (e.g. to keep sessions valid across a rebuild that
# recreates the volume), add the variables in compose.yaml rather than here:
# values are 64+ characters and must not contain `$`. Generate a set with:
#   curl -s https://api.wordpress.org/secret-key/1.1/salt/
# Do not add them as empty strings — that disables the automatic generation.

# ─── Image pins (optional) ───────────────────────────────────
# Defaults are declared in compose.yaml; uncomment to override.
#WORDPRESS_IMAGE=wordpress:7.1-php8.3-apache
#DB_IMAGE=mysql:8.4

# ─── Tuning applied inside wp-config.php (optional) ──────────
# Only edit compose.yaml's WORDPRESS_CONFIG_EXTRA block for these: it is a PHP
# snippet, not plain environment configuration. Current defaults:
#   WP_MEMORY_LIMIT=256M, WP_MAX_MEMORY_LIMIT=512M, WP_POST_REVISIONS=20,
#   DISALLOW_FILE_EDIT=true, AUTOMATIC_UPDATER_DISABLED=false
# PHP upload limits live in uploads.ini (upload_max_filesize / post_max_size).
